# Enable 8250/16550 UART support
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_16550A_VARIANTS=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_BCM2835AUXUART=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_EXAR=y
CONFIG_SERIAL_OF_PLATFORM=y

# Enable PL011 UART support
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Enable Raspberry Pi firmware software UART (optional)
CONFIG_SERIAL_RP2=y

# Enable console on serial port
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y

# Disable Bluetooth to free ttyAMA0
CONFIG_BT=n
CONFIG_BT_HCIUART=n
